<server description="jeee-raaah liberty server">

	<logging traceSpecification="com.ibm.ws.jdbc.*=all:com.ibm.ws.resource.*=all:com.ibm.ws.jca.*=all" />

	<featureManager>
		<!--		<platform>jakartaee-10</platform>-->
		<feature>adminCenter-1.0</feature>
		<feature>jdbc-4.3</feature>
		<!-- allow other jpa implementations than eclipselink -->
		<feature>persistenceContainer-3.1</feature>
		<!-- allow other jsonb implementations than yasson -->
		<!--		<feature>jsonbContainer-3.0</feature>-->
		<!-- make micro profile set of features available at once -->
		<feature>microProfile-6.1</feature>
	</featureManager>

	<!--For a user registry configuration, configure your user registry. For example, configure a basic user registry using the
			basicRegistry element. Specify your own user name below in the name attribute of the user element. For the password,
			generate an encoded password using bin/securityUtility encode and add it in the password attribute of the user element.
			Then uncomment the user element. -->
	<!--
    <basicRegistry id   ="basic"
	               realm="BasicRealm">
		<user name    ="${security_username}"
		      password="${security_password}"/>
	</basicRegistry>
    -->
	<basicRegistry id="basic">
		<user name="${security_username}"
		      password="${security_password}"/>
	</basicRegistry>

	<administrator-role>
		<user>${security_username}</user>
	</administrator-role>

	<!-- This template enables security. To lookup the full use of all the capabilities, a keystore and user registry are required. -->

	<!-- For the keystore, default keys are generated and stored in a keystore. To provide the keystore password, generate an
			encoded password using bin/securityUtility encode and add it below in the password attribute of the keyStore element.
			Then uncomment the keyStore element. -->
	<!--
	<keyStore password=""/>
	<keyStore password="Liberty"/>
	<keyStore id="DefaultKeyStore"
			password="${security_password}"/>
	-->
	<keyStore password="${security_password}"/>

	<!-- Authentication alias for database credentials
	     Why: Avoids embedding username/password in the datasource properties,
	     addresses J2CA8050I, and centralizes secrets.
	     Note: In production, prefer externalized secrets (env/keystore) instead of plaintext. -->
	<authData id="datasource_postgresql_auth"
	          user="${datasource_database_username}"
	          password="${datasource_database_password}"/>

	<remoteFileAccess>
		<writeDir>${server.config.dir}</writeDir>
	</remoteFileAccess>

	<mpMetrics authentication="false"/>

	<httpEndpoint id="defaultHttpEndpoint"
	              httpPort="${default_http_port}"
	              httpsPort="${default_https_port}"
	              host="${default_host_name}"/>

	<!--
	     DataSource Configuration: Simplified without jdbcDriverRef
	     Liberty will automatically find PostgreSQL driver from the WAR's WEB-INF/lib
	-->
	<dataSource id="datasource_postgresql"
	            jndiName="jdbc/datasource_postgresql"
	            type="javax.sql.DataSource"
	            transactional="true"
	            authDataRef="datasource_postgresql_auth">
		<properties.postgresql
		        serverName="${datasource_server_host}"
		        portNumber="${datasource_server_port}"
		        databaseName="${datasource_database}"/>
	</dataSource>

	<!-- Automatically expand WAR files and EAR files -->
	<applicationManager autoExpand="true"/>

	<!-- EclipseLink JPA Configuration - works perfectly with OpenLiberty -->
	<jpa defaultPersistenceProvider="org.eclipse.persistence.jpa.PersistenceProvider"
	     enableBeanValidation="true"
	     enableJPA="true"
	     enableJPAEnhancement="true"/>

	<variable name="de.ruu.app.jeeeraaah.server.system.SystemResource_inMaintenance" value="false"/>

	<webApplication
			contextRoot="/jeee-raaah"
			location="r-uu.codespace.app.jeeeraaah.backend.api.ws.rs.war"
			name="r-uu.codespace.app.jeeeraaah.backend.api.ws.rs">
		<!--
		     Clean classloader configuration without any shared libraries
		     Hibernate and all dependencies are bundled directly in the WAR
		-->
		<classloader apiTypeVisibility="spec, ibm-api, third-party"
		             delegation="parentFirst"/>
	</webApplication>

	<!-- Default SSL configuration enables trust for default certificates from the Java runtime -->
	<ssl id="defaultSSLConfig" trustDefaultCerts="true"/>

</server>